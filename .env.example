NODE_ENV=development
PORT=3001

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- PostgreSQL (existing databases, nothing is created by this app) ----
# Legacy "Db_Affiliate" (DataBaseContext / DefaultConnection) -> PG_AFFILIATE_*
PG_AFFILIATE_HOST=localhost
PG_AFFILIATE_PORT=5432
PG_AFFILIATE_DB=db_affiliate
PG_AFFILIATE_USER=postgres
PG_AFFILIATE_PASSWORD=
# Legacy "Db_Shopping" (shoppingConnection / Cart_Entity) -> PG_SHOPPING_*
PG_SHOPPING_HOST=localhost
PG_SHOPPING_PORT=5432
PG_SHOPPING_DB=db_shopping
PG_SHOPPING_USER=postgres
PG_SHOPPING_PASSWORD=
PG_POOL_MAX=20
PG_SSL=false

# ---- Legacy Web.config appSettings ----
# Key used by UtilityClass.Encryptword / Decryptword (3DES-ECB over MD5(key)); MUST match the legacy value so stored passwords still verify
ENCRYPTION_KEY=replace-with-your-legacy-encryption-key
RECHARGE_TOKEN_KEY=
FCM_SERVER_KEY=
DID=1
PMID=1
